const SHEET_ID="GANTI_DENGAN_ID_GOOGLE_SHEET";
function sheet(n,h){const s=SpreadsheetApp.openById(SHEET_ID);let x=s.getSheetByName(n)||s.insertSheet(n);if(x.getLastRow()==0)x.appendRow(h);return x}
function doPost(e){const d=JSON.parse(e.postData.contents||"{}"),now=new Date();if(d.type==="rsvp")sheet("RSVP",["Timestamp","Nama","Kehadiran","Jumlah Tamu","Pesan","Tamu"]).appendRow([now,d.name,d.attendance,d.guests,d.message,d.guest]);if(d.type==="wish")sheet("Ucapan",["Timestamp","Nama","Ucapan","Tamu"]).appendRow([now,d.name,d.wish,d.guest]);return ContentService.createTextOutput(JSON.stringify({ok:true})).setMimeType(ContentService.MimeType.JSON)}
function doGet(e){if(e.parameter.action!=="wishes")return ContentService.createTextOutput(JSON.stringify({ok:true})).setMimeType(ContentService.MimeType.JSON);const x=sheet("Ucapan",["Timestamp","Nama","Ucapan","Tamu"]).getDataRange().getValues().slice(1).filter(r=>r[1]&&r[2]).slice(-30).reverse().map(r=>({name:r[1],wish:r[2]}));return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON)}
